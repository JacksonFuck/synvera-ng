# Copie para .env e preencha. O .env real NUNCA é versionado (ver .gitignore).
#
#   cp .env.example .env

# ── Caminhos de dados (dentro do repo, versionados por DVC — nunca por git) ──
# inbox/    você joga PDF e MD aqui para serem indexados
# processed/ markdown já tratado — é o que efetivamente alimenta o índice [DVC]
# raw/      PDFs originais e corpora baixados [DVC]
# index/    rag_corpus.db + lancedb — artefato DERIVADO, nunca versionado
SYNVERA_DATA=/home/jackson-fuck/Projetos/Synvera-ng/data
SYNVERA_MODELS=/home/jackson-fuck/Projetos/Synvera-ng/data/models

# ── Super-RAG (services/rag-gateway) ────────────────────────────────────────
# 0.0.0.0 é necessário para o container do LibreChat alcançar o host.
# ATENÇÃO: em deploy com PHI isto expõe o serviço em todas as interfaces —
# trocar por bind no gateway do Docker ou proxy reverso. Ver docs/HANDOFF.md.
RAG_HOST=0.0.0.0
RAG_PORT=8099
RAG_DB_PATH=${SYNVERA_DATA}/index/rag_corpus.db
RAG_LANCEDB_URI=${SYNVERA_DATA}/index/lancedb_corpus
RAG_ADMIN_TOKEN=

# Um único retriever. Com mais de um, api.py cai num cosseno em Python puro sobre
# todos os chunks e a busca vai de ~1s para 204s. Medido.
RAG_RETRIEVERS=bge-m3
RAG_VECTOR_STORE=lancedb
RAG_EMBED_DEVICE=cuda
RAG_EMBED_FP16=1
RAG_RERANK_FP16=1
RAG_SEARCH_TOP_K=8
RAG_CANDIDATE_N=50
RAG_RERANK_MIN=0.3
RAG_MIN_SUPPORTING=1

# Calibração do IVF: ~2% das partições varridas, com re-scoring exato no topo.
RAG_ANN_NPROBES=20
RAG_ANN_REFINE_FACTOR=10

# Grafo. 0 = só as entidades da própria query. Com 194 entidades e 66% de densidade,
# expandir 1-hop trazia 95% do grafo e o sinal virava ruído. Subir só quando houver
# arestas tipadas curadas (ver "programa de RAG, fase B" no HANDOFF).
RAG_GRAPH_ENABLED=true
RAG_GRAPH_NEIGHBORS=0

# ── Orquestrador (services/orchestrator) ────────────────────────────────────
SYNVERA_RAG_URL=http://127.0.0.1:8099
SYNVERA_GEMMA_URL=http://127.0.0.1:8081/v1
SYNVERA_MEISSA_URL=http://127.0.0.1:8003/v1
SYNVERA_MODEL_ID=simvera-triangulo

# Orçamento de latência: 10s ponta a ponta. O Meissa é a perna que estoura primeiro.
SYNVERA_MEISSA_DEADLINE=7
SYNVERA_RAG_TIMEOUT=20
SYNVERA_GEMMA_TIMEOUT=180

# Raciocínio desligado: vale ~20s de TTFT. reasoning_budget=0 NÃO funciona neste
# build do llama.cpp — só chat_template_kwargs.enable_thinking=false.
SYNVERA_GEMMA_THINKING=0

# ── LibreChat ───────────────────────────────────────────────────────────────
# O .env do LibreChat é separado e fica em librechat/.env (também ignorado).
# Copie de librechat/.env.example. Dois pontos obrigatórios lá:
#   ENDPOINTS=custom                  esconde OpenAI/Anthropic/Google nativos
#   sem *_API_KEY=user_provided       senão o usuário cola chave própria e o PHI sai
