[Unit]
Description=Apppocus HTTPS assistant gateway
Documentation=file:%h/Projetos/Apppocus-2.0/gateway/README.md
After=network-online.target apppocus-rag-gateway.service
Wants=network-online.target apppocus-rag-gateway.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projetos/Apppocus-2.0/gateway
EnvironmentFile=%h/Projetos/Apppocus-2.0/gateway/.env
ExecStart=%h/.deno/bin/deno run --allow-net --allow-env --allow-read main.ts
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
