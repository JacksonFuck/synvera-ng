[Unit]
Description=Apppocus Base de Conhecimento sidecar
Documentation=file:%h/Projetos/Apppocus-2.0/rag-gateway/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projetos/Apppocus-2.0/rag-gateway
Environment=RAG_REAL_MODELS=0
ExecStart=/usr/bin/bash -lc 'set -a; . ./.env; set +a; export RAG_REAL_MODELS=0; exec .venv/bin/python -m uvicorn raggw.api:app --host "$RAG_HOST" --port "$RAG_PORT"'
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
