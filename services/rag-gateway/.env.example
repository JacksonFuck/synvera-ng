# RAG Gateway — local-only. ZERO PHI EGRESS: never bind beyond loopback.
RAG_HOST=127.0.0.1
RAG_PORT=8099
RAG_DB_PATH=data/rag_gateway.db

# Admin API (Fase 4): token p/ endpoints /admin/* (header X-Admin-Token).
# Vazio → /admin/* devolve 503 (desabilitado). Defesa em profundidade: role admin
# real é validado no PWA/gateway. NÃO comitar valor real.
RAG_ADMIN_TOKEN=

# Chunking (tokens)
RAG_CHUNK_MIN=350
RAG_CHUNK_MAX=700
RAG_CHUNK_OVERLAP=90

# Ingest quality gate. Empty/garbled docs are always quarantined; the word-count
# floor is opt-in (0 = off) so it never quarantines valid short docs unintentionally.
RAG_QUALITY_MIN_WORDS=0
RAG_QUALITY_MAX_BAD_CHARS=20

# bge-m3 dimension (real embedder, Phase 2+). Tests use FakeEmbedder.
RAG_EMBED_DIM=1024
# Real embedder placement. Default CPU avoids VRAM contention with resident LLMs.
# Set RAG_EMBED_DEVICE=cuda and RAG_EMBED_FP16=1 to keep bge-m3 on GPU for faster ingest/search.
RAG_EMBED_DEVICE=cpu
RAG_EMBED_FP16=0
RAG_EMBED_BATCH_SIZE=12

# Retrieval (Phase 2): hybrid + rerank + abstention
RAG_SEARCH_TOP_K=8
RAG_CANDIDATE_N=50
RAG_RERANK_MIN=0.3
# Reranker real: 'flag' (FlagReranker, padrão) ou 'onnx' (trava no torch atual). RAG_RERANK_FP16=1 p/ half.
RAG_RERANKER=flag
RAG_MIN_SUPPORTING=1
# Diversidade: máx. de chunks por documento no resultado (#322)
RAG_DIVERSITY_FAMILY_CAP=3

# Dense vector store (Phase #202). Default empty/other = brute-force exact scan over SQLite BLOBs.
# Set to "lancedb" to route the dense stage through LanceDB ANN.
RAG_VECTOR_STORE=
RAG_LANCEDB_URI=data/lancedb

# Parser venvs (background-installed). liteparse=simple/fast, MinerU=complex.
# Leave empty to use the in-venv import; set to an external venv python if isolated.
RAG_MINERU_PYTHON=
RAG_LITEPARSE_PYTHON=
